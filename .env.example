# All keys are optional. With none set, Vizzy runs fully offline
# (scripted director + procedural sketch renderer).
# Users can also paste their own keys in Settings; those stay in the browser.

# Director (chat + tool calls)
ANTHROPIC_API_KEY=
# VIZZY_DIRECTOR_MODEL=claude-opus-5-5
# VIZZY_DIRECTOR_EFFORT=low

# Image generation (Gemini is preferred when both are set)
GEMINI_API_KEY=
# VIZZY_GEMINI_MODEL=gemini-nano-banana-2.1
OPENAI_API_KEY=
# VIZZY_OPENAI_MODEL=gpt-image-2
